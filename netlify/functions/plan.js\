// Plan builder: reacts to phase, skill level and hours
function buildPlan({ phase, skillLevel, weeklyHours, userAge }) {
  // Age/phase expectations for hours: more grind when young, more leverage later
  let idealRange;
  if (phase === "learn") {
    idealRange = "15–25 hours/week of focused work is ideal at this stage.";
  } else if (phase === "build") {
    idealRange =
      "15–25 hours/week is a strong builder pace. More is possible if life allows.";
  } else if (phase === "scale") {
    idealRange =
      "10–18 hours/week of deep work plus time spent coordinating with others is realistic at this stage.";
  } else {
    // lead
    idealRange =
      "8–15 hours/week of deep work is enough if you spend the rest of your time leading, delegating and reviewing.";
  }

  let intensityComment;
  if (weeklyHours < 5) {
    intensityComment =
      "Right now your commitment is hobby level. If you actually want to move like these founders, push towards at least 7–10 hours/week.";
  } else if (weeklyHours < 15) {
    intensityComment =
      "Decent starting intensity. To compound you should aim for the upper end of your phase’s range. " +
      idealRange;
  } else {
    intensityComment =
      "You’re in a serious intensity range. The constraint now is focus and ruthless project selection, not raw time. " +
      idealRange;
  }

  let skillComment;
  if (skillLevel === "beginner") {
    if (phase === "learn") {
      skillComment =
        "You are in pure foundation mode. Focus on core skills and tiny complete projects. No chasing 10 ideas at once.";
    } else if (phase === "build") {
      skillComment =
        "You are late to the party compared to your idols. You need to compress fundamentals and shipping into the same month. Expect discomfort.";
    } else {
      skillComment =
        "You are behind on technical fundamentals for your age band. You need aggressive focus on core skills while also executing on leveraged work.";
    }
  } else if (skillLevel === "intermediate") {
    if (phase === "learn") {
      skillComment =
        "You’re ahead of most people in this phase. Lean hard into shipping more projects instead of more tutorials.";
    } else if (phase === "build") {
      skillComment =
        "You should be shipping real, slightly uncomfortable projects and getting feedback from actual users.";
    } else {
      skillComment =
        "Your job now is to convert intermediate skill into visible output: tools, products, dashboards, systems other people actually use.";
    }
  } else {
    // advanced
    if (phase === "learn") {
      skillComment =
        "If you’re truly advanced at this age, your benchmark is building things other people use, not grinding more courses.";
    } else if (phase === "build") {
      skillComment =
        "Stop consuming content. Build one serious project that could be a portfolio centrepiece or early product.";
    } else if (phase === "scale") {
      skillComment =
        "You should be leading projects and systems, not just executing tickets. Focus on architecture, direction and mentoring others.";
    } else {
      skillComment =
        "Your biggest lever now is decisions, people and capital, not code. Act like it.";
    }
  }

  const tasks = [];

  if (phase === "learn") {
    tasks.push(
      "Choose one core skill that matches your idol’s path (e.g. backend, data, hardware). Commit to a single structured resource (course/book) and finish it in 30 days.",
      "Ship 2–3 tiny projects that use this skill and push everything to GitHub. No private work.",
      "Every week, write a 10–15 minute review: what you learned, what you built, what still feels confusing.",
      "Join one builder / hacker / founder community and post a short update every week for accountability."
    );
  } else if (phase === "build") {
    tasks.push(
      "Pick ONE real project that could be used by at least one other person. Define a simple v1 scope you can ship in 30 days.",
      "Block time each week to design, build and deploy that v1 (frontend/backend or whatever stack you choose).",
      "Get at least 3 people to try the product and collect written feedback. Do not argue with them.",
      "At the end of the month, write a one-page retro: what you shipped, what users said, what you’ll change next."
    );
  } else if (phase === "scale") {
    tasks.push(
      "Identify the most valuable thing you already built or can build quickly that others rely on. Make it more robust, documented and easier to use.",
      "Automate or document one process you repeat regularly (scripts, checklists, SOPs). Start acting like someone who runs systems, not tasks.",
      "Collaborate with at least one other person this month: pair on a feature, review their work, or co-own a small project.",
      "Write a weekly status update as if you were reporting to a small team or investor: progress, risks, next steps."
    );
  } else {
    // lead
    tasks.push(
      "Define one clear initiative for the next 30 days where you act as a mini-leader (project, tool, content, small team effort).",
      "Delegate or outsource at least one low-leverage task per week so you can focus on design, decisions and reviews.",
      "Schedule one deep-work block each week to think and write about direction: where you want to be in 12–24 months and what needs to change now.",
      "Do a brutally honest weekly review: what you actually did, what you delegated, what you avoided and why."
    );
  }

  return {
    headline: "Your 30-Day Acceleration Plan",
    meta: {
      intensityComment,
      skillComment,
    },
    tasks,
  };
}

exports.handler = async (event) => {
  if (event.httpMethod === "OPTIONS") {
    return { statusCode: 200, headers, body: "" };
  }

  if (event.httpMethod !== "POST") {
    return {
      statusCode: 405,
      headers,
      body: JSON.stringify({ error: "Method not allowed" }),
    };
  }

  const body = JSON.parse(event.body || "{}");
  let userAge = Number(body.age);
  const idolKey = body.idolKey || "elon_musk";
  const skillLevel = body.skillLevel || "beginner";
  const weeklyHours = Number(body.hoursPerWeek) || 0;

  if (!userAge || userAge < 18) userAge = 18;
  if (userAge > 40) userAge = 40;

  const phase = getPhaseForAge(userAge);
  const idolTimeline = idolData[idolKey] || {};
  let idolSnapshot = idolTimeline[phase];

  if (!idolSnapshot) {
    idolSnapshot = {
      summary: "No timeline data for this idol in this phase yet.",
      skills: [],
      environment: "",
      idolIntensity: "",
    };
  }

  const plan = buildPlan({ phase, skillLevel, weeklyHours, userAge });

  return {
    statusCode: 200,
    headers,
    body: JSON.stringify({
      userAge,
      idol: idolKey,
      phase,
      phaseLabel: phaseLabels[phase],
      idolSnapshot,
      plan,
    }),
  };
};
