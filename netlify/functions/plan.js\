// Map age 18–40 to a phase
function getPhaseForAge(age) {
  if (age <= 21) return "learn";      // 18–21
  if (age <= 27) return "build";      // 22–27
  if (age <= 33) return "scale";      // 28–33
  return "lead";                      // 34–40
}

const phaseLabels = {
  learn: "Learn phase (18–21)",
  build: "Build phase (22–27)",
  scale: "Scale phase (28–33)",
  lead: "Lead phase (34–40)",
};

