/* ==========================
   SMALL UI HELPERS
========================== */
function Pill({ children }) {
  return (
    <span
      style={{
        display: "inline-block",
        padding: "6px 10px",
        borderRadius: 999,
        fontSize: 12,
        fontWeight: 700,
        background: "rgba(80,120,255,0.16)",
        border: "1px solid rgba(120,160,255,0.25)",
      }}
    >
      {children}
    </span>
  );
}

function Button({ children, onClick, disabled }) {
  return (
    <button
      onClick={onClick}
      disabled={disabled}
      style={{
        cursor: disabled ? "not-allowed" : "pointer",
        padding: "10px 14px",
        borderRadius: 12,
        border: "1px solid rgba(255,255,255,0.15)",
        background: disabled ? "rgba(255,255,255,0.06)" : "rgba(255,255,255,0.10)",
        color: "white",
        fontWeight: 800,
      }}
    >
      {children}
    </button>
  );
}

/* ==========================
   APP
========================== */
export default function App() {
  const [selectedId, setSelectedId] = useState(null);

  const enabledFounders = useMemo(() => FOUNDERS.filter((f) => f.active), []);

  const selectedProfile = selectedId ? PROFILES[selectedId] : null;

  return (
    <div
      style={{
        minHeight: "100vh",
        background:
          "radial-gradient(1200px 600px at 20% 10%, rgba(60,120,255,0.35), transparent 60%)," +
          "radial-gradient(900px 500px at 80% 30%, rgba(140,70,255,0.25), transparent 55%)," +
          "linear-gradient(180deg, #070b14 0%, #050814 100%)",
        color: "white",
        padding: 24,
        fontFamily:
          "ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, 'Apple Color Emoji', 'Segoe UI Emoji'",
      }}
    >
      {/* HEADER */}
      <div style={{ maxWidth: 1100, margin: "0 auto" }}>
        <div style={{ letterSpacing: 3, opacity: 0.8, fontSize: 12, fontWeight: 800 }}>
          IDOL PLANNER
        </div>
        <h1 style={{ fontSize: 56, lineHeight: 1.05, margin: "10px 0 8px" }}>
          Idols at a Young Age
        </h1>
        <p style={{ opacity: 0.9, fontSize: 16, maxWidth: 720 }}>
          Pick a founder. Learn what they were doing at key ages — then steal the pattern.
        </p>

        {/* NAV / BACK */}
        <div style={{ marginTop: 14, display: "flex", gap: 10, alignItems: "center" }}>
          {selectedProfile ? (
            <>
              <Button onClick={() => setSelectedId(null)}>← Back</Button>
              <div style={{ opacity: 0.9 }}>
                Viewing: <b>{selectedProfile.name}</b> — {selectedProfile.subtitle}
              </div>
            </>
          ) : (
            <>
              <Pill>Choose a founder</Pill>
              <div style={{ opacity: 0.75 }}>
                Enabled now: {enabledFounders.map((f) => f.name).join(", ")}
              </div>
            </>
          )}
        </div>

        {/* HOME GRID */}
        {!selectedProfile && (
          <div
            style={{
              marginTop: 18,
              display: "grid",
              gridTemplateColumns: "repeat(auto-fit, minmax(260px, 1fr))",
              gap: 14,
            }}
          >
            {FOUNDERS.map((f) => {
              const isEnabled = f.active;
              return (
                <div
                  key={f.id}
                  style={{
                    padding: 16,
                    borderRadius: 18,
                    background: "rgba(255,255,255,0.06)",
                    border: "1px solid rgba(255,255,255,0.12)",
                    boxShadow: "0 18px 50px rgba(0,0,0,0.35)",
                    opacity: isEnabled ? 1 : 0.55,
                  }}
                >
                  <div style={{ display: "flex", justifyContent: "space-between", gap: 10 }}>
                    <div>
                      <div style={{ fontSize: 20, fontWeight: 900 }}>{f.name}</div>
                      <div style={{ opacity: 0.78, fontSize: 13 }}>{f.company}</div>
                    </div>
                    <div
                      style={{
                        width: 46,
                        height: 46,
                        borderRadius: 14,
                        background: "linear-gradient(135deg, rgba(80,120,255,0.35), rgba(255,255,255,0.08))",
                        border: "1px solid rgba(255,255,255,0.12)",
                      }}
                    />
                  </div>

                  <div style={{ marginTop: 12, display: "flex", justifyContent: "space-between", alignItems: "center" }}>
                    <Pill>{f.tag}</Pill>
                    {isEnabled ? (
                      <Button onClick={() => setSelectedId(f.id)}>Open →</Button>
                    ) : (
                      <Button disabled>Coming soon</Button>
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        )}

        {/* DEEP VIEW */}
        {selectedProfile && (
          <div style={{ marginTop: 18 }}>
            <div
              style={{
                padding: 18,
                borderRadius: 18,
                background: "rgba(255,255,255,0.06)",
                border: "1px solid rgba(255,255,255,0.12)",
                boxShadow: "0 18px 50px rgba(0,0,0,0.35)",
              }}
            >
              <h2 style={{ margin: 0, fontSize: 28 }}>{selectedProfile.name}</h2>
              <div style={{ opacity: 0.8, marginTop: 6 }}>{selectedProfile.subtitle}</div>
              <div style={{ marginTop: 10, opacity: 0.9 }}>
                Study the timeline like a playbook: what they built, what they learned, what pattern repeats.
              </div>
            </div>

            <div
              style={{
                marginTop: 14,
                display: "grid",
                gridTemplateColumns: "repeat(auto-fit, minmax(260px, 1fr))",
                gap: 14,
              }}
            >
              {selectedProfile.ages.map((a) => (
                <div
                  key={a.age}
                  style={{
                    padding: 16,
                    borderRadius: 18,
                    background: "rgba(255,255,255,0.06)",
                    border: "1px solid rgba(255,255,255,0.12)",
                    boxShadow: "0 18px 50px rgba(0,0,0,0.35)",
                  }}
                >
                  <div style={{ display: "flex", gap: 12, alignItems: "center" }}>
                    <img
                      src={a.img}
                      alt={`${selectedProfile.name} age ${a.age}`}
                      style={{
                        width: 64,
                        height: 64,
                        borderRadius: 16,
                        objectFit: "cover",
                        border: "1px solid rgba(255,255,255,0.15)",
                      }}
                    />
                    <div>
                      <div style={{ fontSize: 18, fontWeight: 900 }}>
                        Age {a.age} <span style={{ opacity: 0.7, fontWeight: 700 }}>· {a.year}</span>
                      </div>
                      <div style={{ opacity: 0.9, fontWeight: 800 }}>{a.title}</div>
                    </div>
                  </div>

                  <p style={{ marginTop: 12, opacity: 0.9, lineHeight: 1.45 }}>{a.summary}</p>

                  <div style={{ marginTop: 10, fontWeight: 900, opacity: 0.9 }}>What they were doing:</div>
                  <ul style={{ marginTop: 8, paddingLeft: 18, opacity: 0.9, lineHeight: 1.5 }}>
                    {a.doing.map((d, i) => (
                      <li key={i}>{d}</li>
                    ))}
                  </ul>

                  <div style={{ marginTop: 10, fontWeight: 900, opacity: 0.9 }}>Pattern to steal:</div>
                  <div style={{ marginTop: 6, opacity: 0.9, lineHeight: 1.45 }}>{a.pattern}</div>
                </div>
              ))}
            </div>
          </div>
        )}

        {/* FOOTER NOTE */}
        {!selectedProfile && (
          <div
            style={{
              marginTop: 18,
              padding: 14,
              borderRadius: 14,
              background: "rgba(255,255,255,0.06)",
              border: "1px solid rgba(255,255,255,0.12)",
              opacity: 0.9,
            }}
          >
            Tip: If an image doesn’t show, it’s almost always the file path or filename mismatch.
          </div>
        )}
      </div>
    </div>
  );
}
